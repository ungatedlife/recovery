{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doublewinners",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "binding": "ASSETS", "directory": "./dist/client" },
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 0.05 } },
  // Custom domains — zone doublewinners.org is active on this account.
  "routes": [
    { "pattern": "doublewinners.org", "custom_domain": true },
    { "pattern": "www.doublewinners.org", "custom_domain": true }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "doublewinners", "database_id": "00566ac6-7bac-4fee-9400-1f5d5d4d3d1a", "migrations_dir": "db/migrations" }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "da82ed835a5b4475ae12a3322d93831e" }
  ],
  // Requires Workers Paid for the CPU/subrequest budget. Expressions must match src/jobs/index.ts exactly.
  "triggers": { "crons": ["17 9 * * *", "43 */6 * * *", "5 4 * * 1"] },
  "vars": {
    "SITE_NAME": "Double Winners",
    // Cloudflare Access protects /admin. Both must be set here or /admin answers 404.
    // Set them in this file, not the dashboard: `wrangler deploy` overwrites dashboard vars.
    // ACCESS_TEAM_DOMAIN is like "https://yourname.cloudflareaccess.com" (no trailing slash).
    // ACCESS_AUD is the Application Audience tag from the Access application. See README.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Optional: healthchecks.io ping URL, POSTed after each successful scrape.
    "HEALTHCHECK_URL": ""
  }
  // Secrets (wrangler secret put): TEAMUP_TOKEN
}
