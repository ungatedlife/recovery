---
import Layout from '~/components/Layout.astro';
import NextMeetings from '~/islands/NextMeetings.tsx';
import { DATA_SCRIPT_ID, inlineDataset, setCurrentDataset } from '~/lib/current.ts';
import { loadDataset } from '~/lib/data.ts';

const dataset = await loadDataset();
setCurrentDataset(dataset);
const v = Astro.locals.viewer;
Astro.response.headers.set('Cache-Control', 'private, no-cache');
---

<Layout title="double winners — saved" fellowships={dataset.fellowships}>
  <script type="application/json" id={DATA_SCRIPT_ID} set:html={inlineDataset(dataset)} />
  <NextMeetings client:load mode="saved" initialTz={Astro.locals.tz} serverNow={Date.now()} hasSession={v !== null} prefs={v?.prefs ?? null} saved={v?.saved ?? []} hidden={v?.hidden ?? []} />
</Layout>
